# Build output
/dist/
/bin/
# The binary built at the repository root. Anchored: an unanchored `vat`
# would also exclude cmd/vat/, and the entry point would silently never
# be committed.
/vat

# Test and coverage artefacts
*.out
*.test
coverage.html
# `make cover` parses the suite's own output from these and deletes them when it
# finishes. An interrupted run leaves them behind, and a stray build artefact in
# `git status` is how a real change gets missed while reading it.
.coverage-packages
.coverage-shortfall
.coverage-untested

# Local, derived state
.vat/

# Coding-agent session state. These hold transcripts, checkpoints, and replay
# logs of whatever was being worked on, so they are both noise in a diff and
# the kind of thing that must never reach a public history by accident.
.omc/
.claude/state/
.hermes/

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
