#!/bin/sh
# Enforces the commit contract in AGENTS.md at the moment it is broken, rather
# than in a review that happens after the history is written. This project
# refuses to add a rule to `vat lint` that cannot be checked; stating a commit
# contract and never checking it would hold itself to a lower standard than it
# holds a workspace.
#
# Install with `make hooks`. A clone without it is not rejected — the same
# check runs in CI over a pull request's range, so the hook is the fast copy
# and CI is the one that decides.
set -eu
LC_ALL=C
export LC_ALL

# CI checks a pull request's whole range and has no message file, so it passes
# the subject directly. One implementation, because two copies of a rule are
# two rules the day somebody edits one.
if [ "${1:-}" = "--subject" ]; then
  subject=${2:-}
else
  subject=$(sed -n '1p' "$1")
fi

# A merge or a fixup subject is generated by git, not written by anybody, and
# rejecting it would only teach people to pass --no-verify.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  subject: $subject" >&2
  echo "  contract: {feat|fix|refactor|docs|test|chore|perf|ci}: imperative, lower case, no trailing full stop" >&2
  exit 1
}

if [ "${#subject}" -gt 72 ]; then
  fail "subject is ${#subject} characters; the limit is 72"
fi

# Everything user-facing in this repository is English, and a subject is the
# most user-facing line there is.
if ! printf '%s\n' "$subject" | grep -Eq '^[ -~]+$'; then
  fail "subject must be ASCII English"
fi

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|refactor|docs|test|chore|perf|ci): [a-z]'; then
  fail "subject does not start with a known category and a lower-case description"
fi

case "$subject" in
  *.) fail "subject ends with a full stop" ;;
esac
